---
/*
  LeafDivider — a small camellia flower with a leaf either side, and a hairline
  running out to each edge. Used to give the eye a rest between sections instead
  of a hard rule. The drawing lives in PlantDefs.astro.
*/
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={["flex items-center justify-center gap-5", className]}
  aria-hidden="true"
>
  <span class="h-px w-16 bg-rule"></span>

  <svg
    viewBox="14 0 92 56"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-24 shrink-0"
  >
    <use href="#dividerMark" />
  </svg>

  <span class="h-px w-16 bg-rule"></span>
</div>
