---
/*
  PlantDefs — all the plant artwork, defined once per page.
  ---------------------------------------------------------
  Renders a hidden SVG holding the gradients, the vines, and the assembled
  plantings. Everywhere else on the site draws them with <use href="#...">
  rather than repeating the path data.

  That matters here: the leaves are generated individually rather than stamped
  out, so each vine is a few thousand characters of path. Defining them once
  and referencing them keeps the pages light, and lets the same vine appear at
  different sizes and angles without being redrawn.

  Included once, in BaseLayout.astro.
*/
import { buildLeaf } from "../plants";
import Vine from "./Vine.astro";

/* The single leaf used as a bullet point and beside the name. */
const mark = buildLeaf({
  length: 54,
  widthLeft: 17,
  widthRight: 13,
  bend: 0.11,
  droop: 0.03,
  tipPower: 0.92,
  veinPairs: 3,
});

/* The two leaves in the small mark between sections. */
const dividerLeft = buildLeaf({
  length: 40,
  widthLeft: 11,
  widthRight: 13,
  bend: 0.13,
  droop: 0.02,
  tipPower: 0.92,
  veinPairs: 3,
});
const dividerRight = buildLeaf({
  length: 45,
  widthLeft: 13,
  widthRight: 10,
  bend: 0.08,
  droop: 0.05,
  tipPower: 0.92,
  veinPairs: 3,
});
---

<svg
  aria-hidden="true"
  focusable="false"
  width="0"
  height="0"
  style="position:absolute;width:0;height:0;overflow:hidden"
>
  <defs>
    <!-- ============================================================
         Colour. Every leaf is filled with a gradient running from its base to
         its tip, so nothing on the site is a flat block of colour. These use
         objectBoundingBox units, so each gradient adapts to whatever shape it
         lands on.

         Three greens, all muted and slightly warm. Change these and every
         plant on the site changes with them.
         ============================================================ -->
    <linearGradient id="gLeafA" x1="0" y1="0" x2="0.92" y2="0.9">
      <stop offset="0" stop-color="#5c9060" />
      <stop offset="1" stop-color="#2b5632" />
    </linearGradient>
    <linearGradient id="gLeafB" x1="0" y1="0.1" x2="0.9" y2="1">
      <stop offset="0" stop-color="#4a7c50" />
      <stop offset="1" stop-color="#22452a" />
    </linearGradient>
    <linearGradient id="gLeafC" x1="0" y1="0" x2="1" y2="0.75">
      <stop offset="0" stop-color="#6ba06c" />
      <stop offset="1" stop-color="#35603b" />
    </linearGradient>

    <linearGradient id="gVineStem" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#5f8350" />
      <stop offset="0.55" stop-color="#48663c" />
      <stop offset="1" stop-color="#32492a" />
    </linearGradient>

    <!-- ============================================================
         The vines. Each is generated leaf by leaf; change a seed to reshuffle
         one entirely.
         ============================================================ -->
    <g id="vFall"><Vine shape="fall" seed={21} count={19} /></g>
    <g id="vFallShort"><Vine shape="fallShort" seed={48} count={13} /></g>
    <g id="vSweep"><Vine shape="sweep" seed={77} count={18} weight={1.05} /></g>
    <g id="vRise"><Vine shape="rise" seed={13} count={15} /></g>

    <!-- ============================================================
         VARIATION A — a single vine falling in from the top-right corner.
         The default, and the quietest.
         ============================================================ -->
    <g id="plantA"><use href="#vFall" /></g>

    <!-- ============================================================
         VARIATION B — the same vine with a shorter one behind it, so the
         corner is fuller. The two lines cross rather than run in parallel.
         ============================================================ -->
    <g id="plantB">
      <g transform="translate(-26 34) scale(0.82)" opacity="0.85">
        <use href="#vFallShort" />
      </g>
      <use href="#vFall" />
    </g>

    <!-- ============================================================
         VARIATION C — comes in low from the left and sweeps up across the
         frame. For wide, short spaces rather than corners.
         ============================================================ -->
    <g id="plantC"><use href="#vSweep" /></g>

    <!-- ============================================================
         VARIATION D — rises from the bottom-left corner.
         ============================================================ -->
    <g id="plantD"><use href="#vRise" /></g>

    <!-- The single leaf used as a bullet point and beside the name. -->
    <g id="leafMark">
      <path
        d="M3 41C6 37 9 34 12 31"
        stroke="#2c5433"
        stroke-width="3"
        stroke-linecap="round"
        fill="none"
      />
      <g transform="translate(11 33) rotate(-38)">
        <path d={mark.outline} fill="url(#gLeafA)" />
        <path d={mark.shade} fill="#0b2011" opacity="0.13" />
        <path
          d={mark.midrib}
          stroke="#1a3d22"
          stroke-width="1"
          fill="none"
          opacity="0.42"
        />
      </g>
    </g>

    <!-- The small mark between sections: two leaves on a short stem. -->
    <g id="dividerMark">
      <path
        d="M44 40C52 36 60 33 68 32"
        stroke="#3f6440"
        stroke-width="2.6"
        stroke-linecap="round"
        fill="none"
      />
      <g transform="translate(50 37) rotate(196)">
        <path d={dividerLeft.outline} fill="url(#gLeafB)" />
        <path d={dividerLeft.shade} fill="#0b2011" opacity="0.13" />
        <path
          d={dividerLeft.midrib}
          stroke="#1a3d22"
          stroke-width="1"
          fill="none"
          opacity="0.4"
        />
      </g>
      <g transform="translate(62 34) rotate(-22)">
        <path d={dividerRight.outline} fill="url(#gLeafA)" />
        <path d={dividerRight.shade} fill="#0b2011" opacity="0.13" />
        <path
          d={dividerRight.midrib}
          stroke="#1a3d22"
          stroke-width="1"
          fill="none"
          opacity="0.4"
        />
      </g>
    </g>
  </defs>
</svg>
