---
/*
  Footer — contact details, professional membership, and a closing line.
  Everything here is drawn from src/config.ts.
*/
import { site, contact, areas } from "../config";
import Leaf from "./Leaf.astro";

const year = new Date().getFullYear();
---

<footer class="w-full bg-cream border-t border-rule">
  <div class="wrap py-14">
    <div class="flex flex-col sm:flex-row sm:justify-between gap-10">
      <div class="flex items-start gap-3">
        <Leaf class="w-7 mt-1" />
        <div>
          <p class="font-display text-lg text-forest m-0">{site.name}</p>
          <p class="label mt-0.5">{site.role}</p>
          <p class="text-base text-muted mt-3 mb-0">{site.membership}</p>
        </div>
      </div>

      <div class="sm:text-right">
        <p class="label m-0">Get in touch</p>
        <p class="mt-2 mb-0">
          <a
            href={`tel:${contact.phoneTel}`}
            class="font-display text-2xl text-forest no-underline hover:text-green transition-colors whitespace-nowrap"
          >
            {contact.phoneDisplay}
          </a>
        </p>
        {
          contact.email && (
            <p class="mt-1 mb-0">
              <a href={`mailto:${contact.email}`} class="text-forest">
                {contact.email}
              </a>
            </p>
          )
        }
        <p class="text-base text-muted mt-3 mb-0 sm:max-w-xs sm:ml-auto">
          {areas.region}
        </p>
      </div>
    </div>

    <p class="text-sm text-muted mt-12 pt-6 border-t border-rule mb-0">
      © {year} {site.name}. This site offers general information only and is not
      medical advice. I work alongside your GP, hospice and palliative care team,
      and never in place of them.
    </p>
  </div>
</footer>
