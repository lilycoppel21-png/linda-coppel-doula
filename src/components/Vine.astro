---
/*
  Vine — a long, wandering stem with leaves along it. No flowers.
  ---------------------------------------------------------------
  Drawn in a landscape 420 x 320 space.

  Two things matter about the line, and both were wrong in the first attempt:

  1. It travels across, not up. A vertical stem reads as a potted plant
     standing to attention. A vine that moves sideways as much as it rises
     reads as something growing over a surface.

  2. It starts off the edge of its own frame. Every path below begins outside
     the viewBox, so the stem is cut by the edge of the page rather than
     beginning in mid-air with a visible stump. The plant should look like it
     carries on past the corner.

  Every leaf is still generated from its own parameters — length, width either
  side of the midrib, curve, droop, angle — so no two are the same shape.

  Props:
    shape  — which line the vine follows (see PATHS below)
    seed   — any integer; changes every leaf on the vine
    count  — how many leaves
    weight — multiplier on the stem's thickness where it enters the frame
*/
import { makeRng, between, buildLeaf, vineSpine, ribbon } from "../plants";

type Shape = "fall" | "fallShort" | "sweep" | "rise";

interface Props {
  shape?: Shape;
  seed: number;
  count?: number;
  weight?: number;
}

const { shape = "fall", seed, count = 18, weight = 1 } = Astro.props;
const rng = makeRng(seed);
const j = (lo: number, hi: number) => between(rng, lo, hi);

/*
  PATHS
  -----
  Points the vine travels through, thickest at the first. Note that every one
  of them starts beyond the edge of the 420 x 320 frame: that's what makes the
  stem look like it comes in from off the page instead of sprouting from
  nothing.
*/
const PATHS: Record<Shape, [number, number][]> = {
  // Enters at the top-right corner and falls away down and to the left,
  // wandering twice on the way. The main one.
  fall: [
    [470, -60],
    [j(408, 424), j(10, 26)],
    [j(332, 348), j(72, 88)],
    [j(268, 284), j(56, 72)],
    [j(206, 222), j(126, 142)],
    [j(150, 166), j(196, 212)],
    [j(96, 112), j(186, 202)],
    [j(44, 60), j(262, 278)],
  ],
  // The same idea, shorter, for tucking behind the first.
  fallShort: [
    [468, 18],
    [j(394, 410), j(54, 70)],
    [j(326, 342), j(122, 138)],
    [j(262, 278), j(112, 128)],
    [j(198, 214), j(176, 192)],
    [j(148, 164), j(238, 254)],
  ],
  // Comes in low from the left and sweeps up across the frame.
  sweep: [
    [-56, 348],
    [j(36, 52), j(300, 316)],
    [j(122, 138), j(240, 256)],
    [j(206, 222), j(244, 260)],
    [j(286, 302), j(168, 184)],
    [j(360, 376), j(140, 156)],
    [j(444, 460), j(70, 86)],
  ],
  // Rises from the bottom-left corner towards the top-right.
  rise: [
    [-48, 372],
    [j(48, 64), j(296, 312)],
    [j(104, 120), j(214, 230)],
    [j(188, 204), j(178, 194)],
    [j(248, 264), j(104, 120)],
    [j(330, 346), j(56, 72)],
  ],
};

const { spine, normals } = vineSpine(PATHS[shape], 72);
const stem = ribbon(spine, normals, 12 * weight, 2, 1.35);

/* Leaves along the vine. */
const leaves = Array.from({ length: count }, (_, i) => {
  const t = 0.04 + (i / (count - 1)) * 0.93 + between(rng, -0.022, 0.022);
  const idx = Math.min(
    Math.max(Math.round(t * (spine.length - 1)), 0),
    spine.length - 1,
  );
  const [nx, ny] = normals[idx];
  const outward = (Math.atan2(ny, nx) * 180) / Math.PI;

  /*
    Leaves alternate sides. `outward` points straight out from the vine on one
    side; a leaf on the other side starts 180° round. Both are then tilted back
    along the stem. (Negative rotation lifts a shape, because y runs down.)
  */
  const side = i % 2 === 0 ? 1 : -1;
  const lift = between(rng, 26, 64);
  const rotation =
    side === 1
      ? outward - lift + between(rng, -13, 13)
      : outward + 180 + lift + between(rng, -13, 13);

  // Smaller towards the tip, but never so small the vine looks like a fern.
  const taper = Math.pow(1 - t * 0.38, 0.9);
  const length = 50 * taper * between(rng, 0.76, 1.22);
  const half = length * 0.35;
  const twist = between(rng, 0.5, 1);
  const fullLeft = rng() > 0.5;

  return {
    at: spine[idx],
    rotation,
    // Some leaves pass behind the stem, which gives the vine its depth.
    behind: rng() < 0.42,
    tone: Math.floor(between(rng, 0, 3)),
    geometry: buildLeaf({
      length,
      widthLeft: fullLeft ? half : half * twist,
      widthRight: fullLeft ? half * twist : half,
      bend: between(rng, 0.04, 0.17),
      droop: between(rng, -0.05, 0.13),
      tipPower: 0.92,
      scallops: 0,
      veinPairs: 3,
    }),
  };
});

const behind = leaves.filter((l) => l.behind);
const front = leaves.filter((l) => !l.behind);
const fills = ["url(#gLeafA)", "url(#gLeafB)", "url(#gLeafC)"];
---

<g>
  {
    behind.map((leaf) => (
      <g transform={`translate(${leaf.at[0]} ${leaf.at[1]}) rotate(${leaf.rotation})`}>
        <path d={leaf.geometry.outline} fill={fills[leaf.tone]} />
        <path d={leaf.geometry.shade} fill="#0b2011" opacity="0.14" />
      </g>
    ))
  }

  <path d={stem} fill="url(#gVineStem)" />

  {
    front.map((leaf) => (
      <g transform={`translate(${leaf.at[0]} ${leaf.at[1]}) rotate(${leaf.rotation})`}>
        <path d={leaf.geometry.outline} fill={fills[leaf.tone]} />
        <path d={leaf.geometry.shade} fill="#0b2011" opacity="0.12" />
        <path
          d={leaf.geometry.midrib}
          stroke="#1a3d22"
          stroke-width="0.9"
          fill="none"
          opacity="0.38"
        />
        <path
          d={leaf.geometry.veins}
          stroke="#1a3d22"
          stroke-width="0.6"
          fill="none"
          opacity="0.22"
        />
      </g>
    ))
  }
</g>
