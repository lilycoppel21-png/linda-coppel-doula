---
/*
  "Get in touch" page.
  --------------------
  The phone number, big and easy to tap, plus the areas covered.

  There is no contact form here on purpose. A form asks a worried person to
  compose something in writing and then wait. A phone number lets them talk to
  a person today. If you'd like a form added later, it can go underneath the
  number rather than in place of it.

  Phone number and areas come from src/config.ts.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import Leaf from "../components/Leaf.astro";
import { Image } from "astro:assets";
import flowerBand from "../images/flower-band.png";
import { contact, areas } from "../config";
---

<BaseLayout
  title="Get in touch"
  description="Call Linda Coppel, Certified End of Life Doula, on 07767 270884. Home based support across North and North-West London."
>
  <!-- ================= Phone =================
       The number sits on a cream card. The open flower sits below and behind
       it, running off the right-hand edge: this is the page someone reaches
       when they have decided to call, so it carries the resolved image. -->
  <section class="relative overflow-hidden pb-4 lg:pb-16">
    <!-- And the open flower below the card: the end of the sequence, on the
         page someone reaches once they have decided to call. -->
    <div
      class="hidden lg:block absolute inset-y-0 right-0 w-[19%]
             pointer-events-none botanical band-shade"
    >
      <Image
        src={flowerBand}
        alt=""
        widths={[550]}
        sizes="19vw"
        class="w-full h-full object-cover band-fade-left"
        style="object-position: 74% 52%;"
      />
    </div>

    <div class="wrap relative pt-8 sm:pt-10">
    <div
      class="card relative overflow-hidden text-center py-14 sm:py-20
             lg:max-w-[80%] lg:mr-auto"
    >

      <div class="relative">
        <p class="label m-0">Get in touch</p>

        <h1 class="page-title mt-3 mb-0">Let's have a conversation</h1>

        <p class="lead mt-6 mb-0 max-w-xl mx-auto">
          There is no obligation, and no need to know what you want to ask. We
          can simply talk about your situation and whether my support would be
          right for you.
        </p>

        <!-- The number is set large and is its own link, so it can be read
             across a room and tapped without precision. -->
        <p class="mt-10 mb-0">
          <a
            href={`tel:${contact.phoneTel}`}
            class="font-display text-forest no-underline hover:text-green transition-colors"
            style="font-size: clamp(2.125rem, 7vw, 3.25rem);"
          >
            {contact.phoneDisplay}
          </a>
        </p>

        <p class="text-muted mt-4 mb-0">
          If I can't answer, please do leave a message and I will call you back.
        </p>

        {
          contact.email && (
            <p class="mt-6 mb-0">
              Or email me at{" "}
              <a href={`mailto:${contact.email}`}>{contact.email}</a>.
            </p>
          )
        }
      </div>
    </div>
    </div>
  </section>

  <!-- ================= Areas covered =================
       Three columns on wide screens, so fifteen places don't become a long
       thin list down one edge. -->
  <section class="relative overflow-hidden mt-20 sm:mt-28 bg-cream border-y border-rule">
    <div class="wrap py-18 sm:py-24">
      <div class="grid lg:grid-cols-12 gap-8">
        <div class="lg:col-span-4">
          <h2 class="section-title m-0">Where I work</h2>
          <p class="mt-3 mb-0">
            {areas.region}, with a particular focus on these neighbourhoods.
          </p>
          <p class="mt-4 mb-0 text-muted">
            If you are just outside these areas, please still do call. It may
            well be possible.
          </p>
        </div>

        <div class="lg:col-span-8">
          <ul
            class="grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3 list-none m-0 p-0"
          >
            {
              areas.neighbourhoods.map((place) => (
                <li class="flex items-center gap-3">
                  <Leaf class="w-4" />
                  <span>{place}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
