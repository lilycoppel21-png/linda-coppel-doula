---
/*
  Home page.
  ----------
  Someone arriving here may be worried, tired, or reading on a phone at a
  difficult moment. Within a few seconds they should know who Linda is, that
  she is an end of life doula, and what kind of support that means — before
  they are shown any list of services.

  The page runs in this order:
    1. Opening — the practice, Life Endings, and its tagline, then "I am a
       certified end-of-life doula" and the presence she offers.
    2. What matters to me — the personal heart of it, on a centred band.
    3. Time, and a familiar presence — why it matters, for the person and
       for the people around them.
    4. How I can help — the practical and emotional support, as a list.
    5. Experience and professional background — the qualifications.
    6. Let's have a conversation — the invitation to call.

  To change the wording, edit the text below. The phone number, the areas
  covered, the list of support and the qualifications come from src/config.ts.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import Leaf from "../components/Leaf.astro";
import Background from "../components/Background.astro";
import { Image } from "astro:assets";
import budHero from "../images/bud-hero.png";
import fatsiaLeaf from "../images/fatsia-leaf.png";
import flowerOpen from "../images/flower-open.png";
import { site, contact, areas, supportOffered, url } from "../config";
---

<BaseLayout>
  <!-- ================= Opening =================
       The closed bud, entering quietly from the right-hand edge with the words
       keeping the left half to themselves. Its edges are already dissolved
       into transparency in the image file, so there is no mask and no frame
       here — only its position.

       Below 1024px the picture moves underneath the words; see the block after
       the text. -->
  <section class="relative overflow-hidden border-b border-rule lg:min-h-[21rem]">
    <div
      class="hidden lg:block absolute right-[-5%] top-1/2 -translate-y-1/2
             w-[33%] max-w-[28.4375rem] pointer-events-none botanical"
    >
      <Image
        src={budHero}
        alt=""
        widths={[455]}
        sizes="33vw"
        class="w-full h-auto"
      />
    </div>

    <div class="wrap relative pt-24 sm:pt-32 lg:pt-10 pb-16 sm:pb-24 lg:pb-10">
      <!-- Below 1024px the words have the full column. From 1024px up the
           photograph takes the right-hand side. The text runs to a little over
           half the width — wide enough that the two halves read as one
           composition rather than two, and still short of the picture. -->
      <div class="max-w-xl lg:ml-[5%] lg:max-w-[60%]">
        <h1 class="hero-title m-0">{site.practice}</h1>

        <p class="hero-tagline mt-3 mb-0">{site.tagline}</p>

        <p class="lead mt-8 mb-0">
          I am a certified end-of-life doula. I offer a gentle, calming
          presence, respecting each person's beliefs, wishes, and choices.
        </p>

        <p class="mt-5 mb-0">
          That means personal, non-medical support for people approaching the
          end of their lives, and for the families and friends around them.
          {areas.region}.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href={`tel:${contact.phoneTel}`} class="btn">
            <!-- Small telephone mark -->
            <svg
              viewBox="0 0 20 20"
              fill="currentColor"
              class="w-4 h-4 shrink-0"
              aria-hidden="true"
            >
              <path
                d="M2.5 3.5A1.5 1.5 0 0 1 4 2h2a1.5 1.5 0 0 1 1.45 1.11l.6 2.2a1.5 1.5 0 0 1-.4 1.47l-1 1a11.5 11.5 0 0 0 4.07 4.07l1-1a1.5 1.5 0 0 1 1.47-.4l2.2.6A1.5 1.5 0 0 1 18 12.5v2a1.5 1.5 0 0 1-1.5 1.5A13.5 13.5 0 0 1 3 2.5Z"
              ></path>
            </svg>
            Call {contact.phoneDisplay}
          </a>

          <a href={url("/how-i-can-help")} class="text-green">How I can help →</a>
        </div>
      </div>
    </div>

    <!-- Phones and tablets: the words come first and the picture follows,
         shown whole rather than cropped so its dissolved edges still read. -->
    <div class="lg:hidden mt-8 sm:mt-10 botanical">
      <Image
        src={budHero}
        alt=""
        widths={[455]}
        sizes="100vw"
        class="w-full h-auto"
      />
    </div>
  </section>

  <!-- ================= What matters to me =================
       Centred, so it reads differently from the left-aligned opening above
       it: the personal heart of the page. -->
  <section class="relative overflow-hidden border-y border-rule">
    <!-- One fatsia leaf reaching in from the top-left corner on its own stem,
         turned so it hangs diagonally down into the section. The stem runs off
         the corner, so the plant reads as standing outside the page rather
         than as a photograph set beside the words. The wall behind it is close
         to the colour of this band, which is why it sits here and not on the
         green. -->
    <div
      class="hidden sm:block absolute left-[-3%] top-[-7%] w-[22%] max-w-[29.375rem]
             pointer-events-none botanical"
    >
      <Image
        src={fatsiaLeaf}
        alt=""
        widths={[470]}
        sizes="22vw"
        class="w-full h-auto"
      />
    </div>

    <div class="wrap py-12 sm:py-16 text-center relative">
      <h2 class="section-title m-0">What matters to me</h2>

      <div class="max-w-2xl mx-auto mt-5 prose-block">
        <p>
          My aim is to help people feel supported to live their life as fully
          as possible in the time that remains, and to support those close to
          them through what can be an incredibly challenging time.
        </p>
        <p>
          I bring compassion, warmth and gentleness, together with professional
          experience and a willingness to meet each person exactly where they
          are. I want to understand what gives meaning to someone's life.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= Time, and a familiar presence =================
       Left-aligned and plain, in a single readable column. Why the support
       matters, before the list of what it includes. -->
  <section class="wrap py-14 sm:py-20">
    <div class="max-w-2xl lg:ml-[5%]">
      <h2 class="section-title m-0">Time, and a familiar presence</h2>

      <div class="mt-5 prose-block">
        <p>
          When someone is diagnosed with a life limiting illness, life can
          suddenly feel very uncertain. There may be medical decisions to make,
          practical things to sort out, and difficult conversations to begin.
        </p>
        <p>
          Alongside all of this, there is often a need simply for time: to
          talk, to say how you're feeling, or just to sit quietly together. In a
          world where everyone is under pressure, unhurried time is what matters
          most.
        </p>
        <p>
          I can become a familiar presence to be relied on, which can be
          invaluable for working family members, for those living some distance
          away, and for anyone coping with the emotional demands of caring.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= How I can help =================
       On a cream band. Two columns on wide screens so the list doesn't run
       down the page as one long thin ribbon. The list comes from
       `supportOffered` in src/config.ts. -->
  <section class="bg-cream border-y border-rule">
    <div class="wrap py-14 sm:py-20">
      <div class="lg:mx-[5%]">
        <h2 class="section-title m-0">How I can help</h2>
        <p class="mt-3 mb-0">Practical and emotional support can include:</p>

        <ul class="mt-6 grid gap-x-12 gap-y-1 md:grid-cols-2 list-none m-0 p-0">
          {
            supportOffered.map((item) => (
              <li class="flex gap-4 py-4 border-b border-rule">
                <Leaf class="w-5 mt-2 self-start" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-8 mb-0 max-w-2xl">
          I work alongside existing GP, hospice, palliative care, nursing and
          social services. My support complements professional clinical care
          and does not in any way replace it.
        </p>

        <p class="mt-6 mb-0">
          <a href={url("/how-i-can-help")}>More about how I can help →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ================= Experience and professional background =========
       One list rather than separate cards; shared with the About page. -->
  <section class="wrap py-14 sm:py-20">
    <div class="max-w-2xl lg:ml-[5%]">
      <h2 class="section-title m-0">Experience and professional background</h2>

      <div class="mt-6">
        <Background />
      </div>
    </div>
  </section>

  <!-- ================= Closing invitation =================
       The open flower, at the end of the page and the end of the sequence —
       the largest and most resolved of the photographs. It sits below the
       words rather than beside them, in a deliberately tall, empty stretch of
       page, and runs off the bottom-right corner. -->
  <section class="relative overflow-hidden mt-0 mb-0 border-t border-rule text-center lg:text-left">
    <div
      class="hidden lg:block absolute right-[-6%] bottom-[3%] w-[26%] max-w-[34.75rem]
             pointer-events-none botanical"
    >
      <Image
        src={flowerOpen}
        alt=""
        widths={[556]}
        sizes="26vw"
        class="w-full h-auto"
      />
    </div>

    <div class="wrap relative pt-16 sm:pt-20 pb-20 lg:pt-10 lg:pb-10 lg:max-w-[58%]">
      <h2 class="page-title m-0">Let's have a conversation</h2>

      <p class="mt-5 mb-0 max-w-xl mx-auto lg:mx-0">
        We can simply talk about your situation and your needs, and whether my
        support would be right for you.
      </p>

      <p class="mt-8 mb-0">
        <a href={`tel:${contact.phoneTel}`} class="btn">
          Call {contact.phoneDisplay}
        </a>
      </p>

      <p class="text-muted text-base mt-5 mb-0">
        If I can't answer, please do leave a message and I will call you back.
      </p>
    </div>

    <!-- Phones and tablets: beneath the words, closing the page. -->
    <div class="lg:hidden mt-6 mb-2 botanical">
      <Image
        src={flowerOpen}
        alt=""
        widths={[556]}
        sizes="100vw"
        class="w-full h-auto"
      />
    </div>
  </section>
</BaseLayout>
