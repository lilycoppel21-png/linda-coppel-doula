---
/*
  The site — one page.
  --------------------
  Someone arriving here may be worried, tired, or reading on a phone at a
  difficult moment. The opening tells them, at a glance: Life Endings, Linda Coppel, Certified End-of-Life Doula, where she
  works and how to reach her. Everything else is below, to scroll through in
  this order:

    1. Opening — Life Endings, the tagline, Linda's name and role, contact.
    2. What Matters to Me (#about).
    3. How I Can Help (#how-i-can-help) — the support, families and carers,
       and the clinical care note.
    4. Experience and Professional Background.
    5. Let's Have a Conversation (#contact) — phone, email, areas covered.

  Sections alternate between the pale green page and a cream band, with a fine
  rule between them, so each reads as its own step without looking like a
  stack of cards.

  Photographs are kept to two: the open magnolia in the opening, and a fatsia
  leaf by "What Matters to Me".

  To change the wording, edit the text below. The name, phone number, email,
  and areas come from src/config.ts.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import Leaf from "../components/Leaf.astro";
import { Image } from "astro:assets";
import magnoliaHero from "../images/magnolia-hero.png";
import fatsiaLeafFlip from "../images/fatsia-leaf-flip.png";
import { site, contact, areas } from "../config";
---

<BaseLayout>
  <!-- ================= 1. Opening ================= The magnolia comes in from the
       right-hand edge at the full height of the section. Its left, top and
       bottom edges are dissolved into transparency in the image file itself,
       so it meets the page with no rectangle, shadow or frame, and the flower
       stays sharp.

       Below 1024px the words come first and the photograph follows. -->
  <section
    class="relative overflow-hidden lg:flex lg:items-center"
  >
    <!-- Sized by the height of the section and never cropped, so the soft
         top and bottom edges in the file always show. -->
    <Image
      src={magnoliaHero}
      alt=""
      widths={[682]}
      sizes="42vw"
      loading="eager"
      class="hidden lg:block absolute inset-y-0 right-0 h-full w-auto max-w-[48%]
             object-contain object-right pointer-events-none botanical"
    />

    <div class="wrap relative pt-10 sm:pt-12 pb-10 lg:py-12">
      <div class="max-w-[38rem] lg:max-w-[54%]">
        <h1 class="brand-title m-0 flex items-center gap-[0.22em]">
          <Leaf class="w-[0.78em] -mt-[0.08em]" />
          {site.practice}
        </h1>

        <p class="hero-tagline mt-4 mb-0">{site.tagline}</p>

        <hr class="border-0 border-t border-rule my-7 sm:my-8" />

        <p class="hero-name m-0">{site.name}</p>
        <p class="hero-role mt-3 mb-0">Certified End-of-Life Doula</p>

        <!-- Contact. Each line is its own large tap target on a phone. -->
        <ul class="mt-8 list-none m-0 p-0 space-y-2">
          <li>
            <a href={`tel:${contact.phoneTel}`} class="contact-line">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="currentColor" class="w-[1.1rem] h-[1.1rem]">
                  <path d="M2.5 3.5A1.5 1.5 0 0 1 4 2h2a1.5 1.5 0 0 1 1.45 1.11l.6 2.2a1.5 1.5 0 0 1-.4 1.47l-1 1a11.5 11.5 0 0 0 4.07 4.07l1-1a1.5 1.5 0 0 1 1.47-.4l2.2.6A1.5 1.5 0 0 1 18 12.5v2a1.5 1.5 0 0 1-1.5 1.5A13.5 13.5 0 0 1 3 2.5Z"></path>
                </svg>
              </span>
              <span class="sr-only">Phone: </span>{contact.phoneDisplay}
            </a>
          </li>
          {
            contact.email && (
              <li>
                <a href={`mailto:${contact.email}`} class="contact-line">
                  <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="w-[1.1rem] h-[1.1rem]">
                      <path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h13A1.5 1.5 0 0 1 18 5.5v.4l-8 5-8-5v-.4Z"></path>
                      <path d="M2 7.6V14.5A1.5 1.5 0 0 0 3.5 16h13a1.5 1.5 0 0 0 1.5-1.5V7.6l-7.6 4.75a.75.75 0 0 1-.8 0L2 7.6Z"></path>
                    </svg>
                  </span>
                  <span class="sr-only">Email: </span>{contact.email}
                </a>
              </li>
            )
          }
          <li class="contact-line">
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="currentColor" class="w-[1.1rem] h-[1.1rem]">
                <path fill-rule="evenodd" d="M10 1.75a6 6 0 0 0-6 6c0 4.3 4.9 9.6 5.46 10.2a.75.75 0 0 0 1.08 0C11.1 17.35 16 12.05 16 7.75a6 6 0 0 0-6-6Zm0 8.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" clip-rule="evenodd"></path>
              </svg>
            </span>
            <span class="sr-only">Area: </span>{areas.short}
          </li>
        </ul>
      </div>
    </div>

    <!-- Phones and tablets: the photograph follows the words, never over
         them. -->
    <div class="lg:hidden botanical flex justify-end">
      <Image
        src={magnoliaHero}
        alt=""
        widths={[682]}
        sizes="(min-width: 640px) 70vw, 100vw"
        class="w-full sm:w-[70%] h-auto"
      />
    </div>
  </section>

  <!-- ================= 2. What Matters to Me (#about) =================
       The fatsia leaf reaches in from the bottom-right corner, beyond the end
       of the lines of text and well clear of the magnolia above. -->
  <section id="about" class="section relative overflow-hidden border-t border-rule">
    <div
      class="hidden lg:block absolute right-[-3%] bottom-0 w-[20%] max-w-[29.375rem]
             pointer-events-none botanical feather"
    >
      <Image
        src={fatsiaLeafFlip}
        alt=""
        widths={[470]}
        sizes="20vw"
        class="w-full h-auto"
      />
    </div>

    <div class="wrap relative">
      <div class="max-w-3xl">
        <h2 class="section-title m-0">What Matters to Me</h2>

        <div class="mt-5 prose-block">
          <p>
            When someone is diagnosed with a life limiting illness, life can
            suddenly feel very uncertain. There may be medical decisions to
            make, practical things to sort out, and difficult conversations to
            begin.
          </p>
          <p>
            My aim is to help people feel supported to live their life as fully
            as possible in the time that remains, and to support those close to
            them through what can be an incredibly challenging time.
          </p>
          <p>
            Time to talk, time to express feelings, time to sit quietly and
            simply be with the person. In a world where everyone is under
            pressure, unhurried time is often what matters the most.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 3. How I Can Help (#how-i-can-help) =================
       On a cream band. The support itself on the left, written as prose
       rather than a list; families and carers, and the clinical care note,
       on the right. -->
  <section id="how-i-can-help" class="section bg-cream border-y border-rule">
    <div class="wrap">
      <div>
        <h2 class="section-title m-0">How I Can Help</h2>

        <div class="mt-5 grid gap-8 lg:grid-cols-2 lg:gap-14">
          <div class="prose-block">
            <p>
              Every person has their own way of experiencing illness, dying and
              death. My role is to listen carefully, and to understand what is
              important to that particular person.
            </p>
            <p>
              I can be a regular and reassuring presence: someone to have
              conversations about dying and death with, and to explore
              relationships, unresolved issues and what matters most. I can
              help with advance planning and communicating wishes, and with
              everyday practicalities if needed, so that life can be lived
              right up to the end.
            </p>
          </div>

          <div class="space-y-7">
            <div>
              <h3 class="subheading m-0">For Families and Carers</h3>
              <p class="mt-1.5 mb-0">
                My support reaches the people around the person, too. I can
                become a familiar presence to be relied on, which can be
                invaluable for working family members, for those living some
                distance away, and for anyone coping with the emotional demands
                of caring.
              </p>
            </div>

            <div>
              <h3 class="subheading m-0">Alongside Your Clinical Care</h3>
              <p class="mt-1.5 mb-0">
                I work alongside existing GP, hospice, palliative care, nursing
                and social services. My support complements professional
                clinical care and does not in any way replace it.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 4. Experience and Professional Background ======== -->
  <section class="section">
    <div class="wrap">
      <div class="max-w-3xl">
        <h2 class="section-title m-0">Experience and Professional Background</h2>

        <div class="mt-5 prose-block">
          <p>
            I am a Certified End of Life Doula, trained at Crossfields
            Institute, and a member of End of Life Doula UK.
          </p>
          <p>
            I have worked as a therapist for over 30 years, with both
            individuals and communities, and as a bereavement counsellor for
            16 years.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 5. Let's Have a Conversation (#contact) ==========
       On a cream band. How to get in touch on the left, the areas covered on
       the right, so the section stays short. -->
  <section id="contact" class="section bg-cream border-t border-rule">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <h2 class="section-title m-0">Let's Have a Conversation</h2>

          <p class="mt-4 mb-0">
            We can simply talk about your situation and your needs, and whether
            my support would be right for you.
          </p>

          <!-- The number is set large and is its own link, so it can be read
               across a room and tapped without precision. -->
          <p class="mt-6 mb-0">
            <a
              href={`tel:${contact.phoneTel}`}
              class="font-display text-forest no-underline hover:text-green transition-colors"
              style="font-size: clamp(2rem, 4.5vw, 2.75rem);"
            >
              {contact.phoneDisplay}
            </a>
          </p>

          {
            contact.email && (
              <p class="mt-1 mb-0 text-xl">
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </p>
            )
          }

          <p class="text-muted mt-4 mb-0">
            If I can't answer, please do leave a message and I will call you
            back.
          </p>
        </div>

        <div class="lg:col-span-7">
          <h3 class="subheading m-0">Where I Work</h3>
          <p class="mt-2 mb-0">
            {areas.region}, with a particular focus on:
          </p>

          <ul class="mt-4 grid gap-x-6 gap-y-2 grid-cols-2 sm:grid-cols-3 list-none m-0 p-0 text-[1.0625rem] sm:text-xl">
            {
              areas.neighbourhoods.map((place) => (
                <li class="flex items-center gap-3">
                  <Leaf class="w-4" />
                  <span>{place}</span>
                </li>
              ))
            }
          </ul>

          <p class="mt-5 mb-0 text-muted">
            If you are just outside these areas, please still do call. It may
            well be possible.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
