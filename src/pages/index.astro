---
/*
  Home page.
  ----------
  Kept deliberately simple. Someone arriving here may be worried, tired, or
  reading on a phone at a difficult moment. The job of this page is to say what
  the support is, to feel calm, and to make the phone number easy to find —
  then let them go deeper only if they want to.

  There are only three things on it: the opening, a short passage on a green
  band, and an invitation to call. Anything more detailed belongs on
  "How I can help" rather than here.

  To change the wording, edit the text below. The phone number and the areas
  covered come from src/config.ts.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import budHero from "../images/bud-hero.png";
import leafGlossy from "../images/leaf-glossy.png";
import sprigLeft from "../images/sprig-left.png";
import fatsiaDetail from "../images/fatsia-detail.png";
import flowerOpen from "../images/flower-open.png";
import { contact, areas, url } from "../config";
---

<BaseLayout>
  <!-- ================= Opening =================
       The closed bud, entering quietly from the right-hand edge with the words
       keeping the left half to themselves. Its edges are already dissolved
       into transparency in the image file, so there is no mask and no frame
       here — only its position.

       Below 1024px the picture moves underneath the words; see the block after
       the text. -->
  <section class="relative overflow-hidden lg:min-h-[31rem]">
    <div
      class="hidden lg:block absolute right-[2%] top-1/2 -translate-y-1/2
             w-[34%] max-w-[31.5rem] pointer-events-none botanical"
    >
      <Image
        src={budHero}
        alt=""
        widths={[380, 506]}
        sizes="34vw"
        class="w-full h-auto"
      />
    </div>

    <!-- A couple of glossy leaves low on the other side, mostly past the edge
         of the screen. Small, and easy to miss — which is the point. -->
    <div
      class="hidden md:block absolute -left-[6%] bottom-2 w-[13%] max-w-[11rem]
             pointer-events-none botanical"
    >
      <Image
        src={leafGlossy}
        alt=""
        widths={[221]}
        sizes="13vw"
        class="w-full h-auto"
      />
    </div>

    <div class="wrap relative pt-24 sm:pt-32 lg:pt-16 pb-12 sm:pb-16">
      <!-- Below 1024px the words have the full column. From 1024px up the
           photograph takes the right-hand side, so the text is held to a
           share of the column and never runs into it. -->
      <div class="max-w-xl lg:max-w-[46%]">
        <h1 class="hero-title m-0">
          Time to listen.<br />Time to be there.
        </h1>

        <p class="lead mt-7 mb-0">
          Compassionate, non-medical support for people approaching the end of
          their lives, and for the families and friends around them.
        </p>

        <p class="text-muted mt-5 mb-0">{areas.region}.</p>

        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href={`tel:${contact.phoneTel}`} class="btn">
            <!-- Small telephone mark -->
            <svg
              viewBox="0 0 20 20"
              fill="currentColor"
              class="w-4 h-4 shrink-0"
              aria-hidden="true"
            >
              <path
                d="M2.5 3.5A1.5 1.5 0 0 1 4 2h2a1.5 1.5 0 0 1 1.45 1.11l.6 2.2a1.5 1.5 0 0 1-.4 1.47l-1 1a11.5 11.5 0 0 0 4.07 4.07l1-1a1.5 1.5 0 0 1 1.47-.4l2.2.6A1.5 1.5 0 0 1 18 12.5v2a1.5 1.5 0 0 1-1.5 1.5A13.5 13.5 0 0 1 3 2.5Z"
              ></path>
            </svg>
            Call {contact.phoneDisplay}
          </a>

          <a href={url("/how-i-can-help")} class="text-green">How I can help →</a>
        </div>
      </div>
    </div>

    <!-- Phones and tablets: the words come first and the picture follows,
         shown whole rather than cropped so its dissolved edges still read. -->
    <div class="lg:hidden mt-8 sm:mt-10 botanical">
      <Image
        src={budHero}
        alt=""
        widths={[480, 664]}
        sizes="100vw"
        class="w-full h-auto"
      />
    </div>
  </section>

  <!-- ================= A short word, centred =================
       Centred on a deeper green band, so it reads differently from the
       left-aligned opening above it. -->
  <section class="relative overflow-hidden bg-cream border-y border-rule">
    <!-- Fatsia coming in along the left-hand edge, against a wall the same
         warmth as this band. Foliage is the middle of the sequence: past the
         closed bud, not yet the open flower. -->
    <div
      class="hidden sm:block absolute left-0 bottom-0 w-[20%] max-w-[18.75rem]
             pointer-events-none botanical"
    >
      <Image
        src={sprigLeft}
        alt=""
        widths={[300]}
        sizes="20vw"
        class="w-full h-auto"
      />
    </div>

    <!-- And the tip of a fatsia leaf dropping in over the top-right corner,
         cut off by the edge of the band. -->
    <div
      class="hidden lg:block absolute right-[6%] -top-[3%] w-[12%] max-w-[10rem]
             pointer-events-none botanical"
    >
      <Image
        src={fatsiaDetail}
        alt=""
        widths={[202]}
        sizes="12vw"
        class="w-full h-auto"
      />
    </div>

    <div class="wrap py-16 sm:py-20 text-center relative">
      <div class="max-w-2xl mx-auto prose-block">
        <p>
          When someone is diagnosed with a life limiting illness, life can
          suddenly feel very uncertain. There may be medical decisions to make,
          practical issues to consider, and difficult conversations to begin.
        </p>
        <p>
          Alongside all of this, there is often a need simply to have someone to
          talk to. Someone with time to listen, and to be there.
        </p>
      </div>

      <p class="pull-line mt-14 mb-0">This is where I can help.</p>

      <p class="mt-8 mb-0">
        <a href={url("/how-i-can-help")}>What my support can offer →</a>
      </p>
    </div>
  </section>

  <!-- ================= Closing invitation =================
       The open flower, at the end of the page and the end of the sequence —
       the largest and most resolved of the photographs. It sits below the
       words rather than beside them, in a deliberately tall, empty stretch of
       page, and runs off the bottom-right corner. -->
  <section class="relative overflow-hidden mt-16 sm:mt-20 mb-4 text-center">
    <div
      class="hidden lg:block absolute right-0 bottom-0 w-[36%] max-w-[34rem]
             pointer-events-none botanical"
    >
      <Image
        src={flowerOpen}
        alt=""
        widths={[420, 550]}
        sizes="36vw"
        class="w-full h-auto"
      />
    </div>

    <div class="wrap relative py-12 pb-20 lg:pb-[21rem]">
      <h2 class="page-title m-0">If you'd like to talk</h2>

      <p class="mt-5 mb-0 max-w-xl mx-auto">
        There is no obligation in getting in touch. We can simply have a
        conversation about your situation and whether my support would be right
        for you.
      </p>

      <p class="mt-8 mb-0">
        <a href={`tel:${contact.phoneTel}`} class="btn">
          Call {contact.phoneDisplay}
        </a>
      </p>

      <p class="text-muted text-base mt-5 mb-0">
        If I can't answer, please do leave a message and I will call you back.
      </p>
    </div>

    <!-- Phones and tablets: beneath the words, closing the page. -->
    <div class="lg:hidden mt-6 mb-2 botanical">
      <Image
        src={flowerOpen}
        alt=""
        widths={[420, 550]}
        sizes="100vw"
        class="w-full h-auto"
      />
    </div>
  </section>
</BaseLayout>
